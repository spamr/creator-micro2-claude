{
  "_comment": "Bindings per frontmost app (bundle id). Inputs: ACT06-ACT09 command keys (left to right), ACT10/ACT11 mic bar, ACT12 bottom key, ENC_CW/ENC_CC dial turn, ENC_CLK dial click, joystick up/down/left/right. Binding: \"none\" | {\"key\": \"cmd+shift+]\"} | {\"key\": \"space\", \"hold\": true} | {\"scroll\": 3} | {\"exec\": [\"open\", \"-a\", \"Claude\"]} | {\"exec\": [...], \"release\": [...]} | {\"session\": \"urgent\" | \"next\" | \"prev\"}. See README. Optional \"agent_key_order\" lists which agent keys sessions may use, in order (default 1 to 6). \"session_expiry_hours\": a finished or idle session silent this long gives its key back (default 4).",
  "targets": {
    "com.anthropic.claudefordesktop": {
      "name": "Claude desktop app",
      "ACT06": {
        "key": "cmd+n"
      },
      "ACT07": {
        "key": "escape"
      },
      "ACT08": {
        "key": "cmd+f"
      },
      "ACT09": {
        "key": "cmd+shift+k"
      },
      "ACT10": {
        "key": "cmd+shift+i",
        "menu": {
          "ENC_CW": {
            "key": "down"
          },
          "ENC_CC": {
            "key": "up"
          },
          "ENC_CLK": {
            "key": "return"
          }
        }
      },
      "ACT11": {
        "exec": [
          "open",
          "-g",
          "wispr-flow://start-hands-free"
        ],
        "release": [
          "open",
          "-g",
          "wispr-flow://stop-hands-free"
        ]
      },
      "ACT12": {
        "key": "return"
      },
      "ENC_CW": {
        "scroll": 3,
        "window": "Claude",
        "at": [
          0.5,
          0.4
        ]
      },
      "ENC_CC": {
        "scroll": -3,
        "window": "Claude",
        "at": [
          0.5,
          0.4
        ]
      },
      "ENC_CLK": {
        "key": "cmd+shift+e",
        "menu": {
          "ENC_CW": {
            "key": "down"
          },
          "ENC_CC": {
            "key": "up"
          },
          "ENC_CLK": {
            "key": "return"
          }
        }
      },
      "joystick": {
        "up": {
          "key": "cmd+shift+["
        },
        "down": {
          "key": "cmd+shift+]"
        }
      }
    },
    "com.googlecode.iterm2": {
      "name": "Claude Code in iTerm",
      "ACT06": "none",
      "ACT07": {
        "key": "escape"
      },
      "ACT08": {
        "key": "cmd+shift+["
      },
      "ACT09": {
        "key": "cmd+shift+]"
      },
      "ACT10": "none",
      "ACT11": {
        "exec": [
          "open",
          "-g",
          "wispr-flow://start-hands-free"
        ],
        "release": [
          "open",
          "-g",
          "wispr-flow://stop-hands-free"
        ]
      },
      "ACT12": {
        "key": "return"
      },
      "ENC_CW": {
        "key": "shift+up"
      },
      "ENC_CC": {
        "key": "shift+down"
      },
      "ENC_CLK": "none"
    }
  },
  "session_expiry_hours": 4
}
